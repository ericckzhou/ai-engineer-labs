# [provided] Copy this file to .env and pick ONE path. The provider auto-selects (see config.py).

# --- Option A: Local Ollama (free, no key, runs offline) ----------------------
# Requires a running Ollama server with the chat model pulled:  ollama pull qwen3.5:4b
# USE_OLLAMA=1
# OLLAMA_MODEL=ollama/qwen3.5:4b      # optional override of chat default

# --- Option B: Cloud provider (auto-selects from whichever key you set) --------
# Groq is preferred — it has a FREE TIER.
GROQ_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# Optional overrides (defaults shown) — uncomment to change.
# LLM_MODEL=ollama/qwen3.5:4b        # explicit model string; always wins
# CHATBOT_MODEL=groq/llama-3.3-70b-versatile
# CHATBOT_TEMPERATURE=0.7
# CHATBOT_MAX_TOKENS=1024
# CHATBOT_CONTEXT_BUDGET=100000
# CHATBOT_SYSTEM_PROMPT=You are a concise, helpful assistant.
