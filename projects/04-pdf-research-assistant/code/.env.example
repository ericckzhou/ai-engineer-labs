# [provided] CANONICAL TEMPLATE — skills/lesson-generator/templates/.env.example
# Copy this file to .env and pick ONE path. The provider auto-selects (see config.py).

# --- Option A: Local Ollama (free, no key, runs offline) ----------------------
# Requires a running Ollama server with the models pulled:
#   ollama pull qwen3.5:4b          # chat
#   ollama pull nomic-embed-text    # embeddings (768-dim)
# Then just set:
# USE_OLLAMA=1
# OLLAMA_MODEL=ollama/qwen3.5:4b              # optional override of chat default
# OLLAMA_EMBEDDING_MODEL=ollama/nomic-embed-text  # optional override of embed default

# --- Option B: Cloud provider (auto-selects from whichever key you set) --------
# Groq is preferred — it has a FREE TIER.
GROQ_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here     # also enables OpenAI embeddings (text-embedding-3-small)

# --- Optional overrides — uncomment to change ---------------------------------
# LLM_MODEL=ollama/qwen3.5:4b      # explicit model string; always wins
# EMBEDDING_MODEL=ollama/nomic-embed-text  # explicit embedding model; always wins
# RAG_TEMPERATURE=0.0              # grounded answering wants low temperature (faithful, not creative)
# RAG_CHUNK_SIZE=500               # chunk size in whitespace tokens
# RAG_CHUNK_OVERLAP=80             # overlap between adjacent chunks
# RAG_TOP_K=4                      # how many chunks to retrieve into the prompt
# CHATBOT_MAX_TOKENS=1024
