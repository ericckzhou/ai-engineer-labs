# [provided] CANONICAL TEMPLATE — skills/lesson-generator/templates/.env.example
# Copy this file to .env and fill in. At least one provider key is required.
# The provider auto-selects from whichever key you set (see config.py PROVIDER_DEFAULTS).
# Groq is preferred — it has a FREE TIER — so set GROQ_API_KEY to use the free default.
GROQ_API_KEY=your-key-here

# Set any of these instead and the default model swaps automatically (Groq > Anthropic > OpenAI):
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# Optional overrides — uncomment to change.
# CHATBOT_MODEL=groq/llama-3.3-70b-versatile
# CHATBOT_TEMPERATURE=0.7
# CHATBOT_MAX_TOKENS=1024
