# The offline core (M1–M5) needs NONE of these — it runs against fake_backend.py.
# Set ONE provider only for the live-LLM extension (swap fake_backend for a real model).

# Local (free, offline-ish): install Ollama, then:
# USE_OLLAMA=1
# OLLAMA_MODEL=ollama/qwen3.5:4b

# Or a cloud provider (first key found wins; see config.py PROVIDER_DEFAULTS):
# GROQ_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# Force a specific model id regardless of provider:
# LLM_MODEL=groq/llama-3.3-70b-versatile
