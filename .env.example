# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ─── LLM Providers ───────────────────────────────────────────────────────────
# Anthropic Claude (recommended primary)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (optional — for comparison/evaluation)
# OPENAI_API_KEY=sk-your-key-here

# Groq (optional — fast inference, free tier)
# GROQ_API_KEY=your-key-here

# Together AI (optional — open models)
# TOGETHER_API_KEY=your-key-here

# ─── Vector Databases (Project 3+) ───────────────────────────────────────────
# Pinecone (managed)
# PINECONE_API_KEY=your-key-here
# PINECONE_ENVIRONMENT=us-east-1

# Qdrant Cloud (managed)
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your-key-here

# ─── Other Services ───────────────────────────────────────────────────────────
# Tavily (web search for agents, Project 8)
# TAVILY_API_KEY=your-key-here

# ─── Lab Settings ─────────────────────────────────────────────────────────────
DEFAULT_MODEL=claude-sonnet-4-6
LOG_LEVEL=INFO
